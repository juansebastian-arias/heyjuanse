{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/.next",
      "!**/node_modules",
      "!data/**/*.json",
      "!public/data",
      "!playwright-report",
      "!test-results"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "javascript": {
    "formatter": { "quoteStyle": "double", "semicolons": "always", "trailingCommas": "all" }
  },
  "css": { "parser": { "cssModules": true } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": { "noNonNullAssertion": "error", "useImportType": "error" },
      "suspicious": { "noConsole": { "level": "warn", "options": { "allow": ["error", "warn"] } } },
      "correctness": {
        "useExhaustiveDependencies": "error",
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["core/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react": "core/ holds business logic only. UI code belongs in components/.",
                  "react-dom": "core/ holds business logic only.",
                  "next": "core/ must not depend on the web framework.",
                  "@anthropic-ai/sdk": "Model calls live in server/ and scripts/, never in core/."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["scripts/**"],
      "linter": { "rules": { "suspicious": { "noConsole": "off" } } }
    }
  ],
  "assist": { "enabled": true, "actions": { "source": { "organizeImports": "on" } } }
}
